#!/bin/sh
# core.hooksPath を .git/hooks に固定しているため、upstream の .vite-hooks/pre-commit をここから委譲する。

[ "$(git symbolic-ref -q --short HEAD)" = meta ] && exit 0
{ [ "${HUSKY-}" = "0" ] || [ "${VP_GIT_HOOKS-}" = "0" ] || [ "${VITE_GIT_HOOKS-}" = "0" ]; } && exit 0

top=$(git rev-parse --show-toplevel) || exit 0
hook="$top/.vite-hooks/pre-commit"
[ -f "$hook" ] || exit 0

if [ -d "$top/node_modules/.bin" ]; then
  export PATH="$top/node_modules/.bin:$PATH"
fi

exec sh -e "$hook" "$@"
